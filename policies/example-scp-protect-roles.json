{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyStackSetsChangeDebugLogManagerRoles",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/DebugLogManager-reader",
        "arn:aws:iam::*:role/DebugLogManager-worker",
        "arn:aws:iam::*:role/DebugLogManager-flowlogs-delivery",
        "arn:aws:iam::*:role/DebugLogManager-apigateway-cloudwatch"
      ],
      "Condition": {
        "ArnNotLike": { "aws:PrincipalArn": "arn:aws:iam::*:role/stacksets-exec-*" }
      }
    },
    {
      "Sid": "OnlyStackSetsChangeDebugLogManagerPolicies",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::*:policy/DebugLogManager-worker-*",
      "Condition": {
        "ArnNotLike": { "aws:PrincipalArn": "arn:aws:iam::*:role/stacksets-exec-*" }
      }
    }
  ]
}
